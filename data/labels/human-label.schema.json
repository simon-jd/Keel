{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Genuine human BFCL annotation (one JSONL record)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "rater", "origin", "rubricVersion", "cohortHash", "annotatedAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "label": {"enum": ["pass", "fail"]},
    "rater": {"type": "string", "minLength": 1, "maxLength": 128},
    "origin": {"const": "human"},
    "rubricVersion": {"const": "bfcl-action-v1"},
    "cohortHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotatedAt": {"type": "string", "format": "date-time"}
  }
}
