# Copy to infra/.env (gitignored). Populate every required value with fresh secrets.
# Generate URL-safe database passwords / app secrets with: openssl rand -hex 32
KEEL_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_PASSWORD=
REDIS_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
# Required only for the explicit opt-in metrics exporter; base64(public-key:secret-key).
LANGFUSE_OTLP_AUTH_BASE64=
# Explicit opt-in after verifying the local metrics-only pipeline (default is ./otel-collector.yaml -> nop).
# OTEL_COLLECTOR_CONFIG=./otel-collector.langfuse.yaml
# Application OTLP signal endpoint (host process; /v1/traces is required).
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:14318/v1/traces
